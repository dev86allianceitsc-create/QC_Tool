# Prisma datasource connection string. Copy to .env and fill in real values —
# .env is gitignored and must never be committed.
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>?schema=public"

# apps/api (NestJS) runtime config
API_PORT=3000
CORS_ORIGIN=http://localhost:8443

# Google OAuth Authorization Code Flow + PKCE (server-side exchange).
# Placeholders only — never commit real values.
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8443/auth/google/callback

# Session (user_sessions) lifetime in hours. Default 8.
SESSION_TTL_HOURS=8
