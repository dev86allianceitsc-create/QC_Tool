# Prisma datasource connection string. Copy to .env and fill in real values —
# .env is gitignored and must never be committed.
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>?schema=public"

# apps/api (NestJS) runtime config
API_PORT=3000
CORS_ORIGIN=http://localhost:8443

# Google OAuth Authorization Code Flow + PKCE (server-side exchange).
# Placeholders only — never commit real values.
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8443/auth/google/callback

# Session (user_sessions) lifetime in hours. Default 8.
SESSION_TTL_HOURS=8

# AES-256-GCM key used to encrypt Authentication Configuration secrets
# (Group 3C, REQ-SEC-002) at rest — base64-encoded, must decode to exactly 32
# bytes. Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never commit a real value; rotating this key makes previously stored
# credentials undecryptable.
CREDENTIAL_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# Development/demo seed only (prisma/seed.mjs — `pnpm db:seed`). Must be an
# email you personally control for the live mentor demo's Google first-login
# flow. Never a placeholder value the seed would silently accept, and never
# committed as a real address — set it in your local .env only.
SEED_ADMIN_EMAIL=<your-dev-google-email>@example.com
