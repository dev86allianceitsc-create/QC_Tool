# Frontend-safe environment variables only. Vite exposes every VITE_-prefixed
# variable to client-side code, so nothing backend-only (GOOGLE_CLIENT_SECRET,
# DATABASE_URL, etc.) may ever be added to this file or its local .env copy.

# Base URL of the QC Tool API (apps/api), including its global "api/v1" prefix.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Public Google OAuth 2.0 Web client ID used only to start the browser-side
# Authorization Code redirect. The matching client secret stays backend-only
# (GOOGLE_CLIENT_SECRET in the root .env) and is never used here.
VITE_GOOGLE_CLIENT_ID=
