// Database Phase B — User & Authentication implementation.
// Source of truth: document/database/Database_AnD.docx (post VARCHAR Physical
// Design Decision, approved 2026-09-11) and document/database/Database_Standard_v2.0.docx.
//
// Database Phase C — Project Management & Audit Log implementation.
// Source of truth: document/database/AnD_Database_Project_Audit.docx
// (status: IMPLEMENTATION READY - reviewed and frozen for current scope) and
// document/database/Database_Standard_v2.0.docx.
//
// Group 3A — API & Environment Core implementation.
// Source of truth: document/database/AnD_Database_API_Environment_Core_3A.docx
// (status: FINAL FOR 3A LOGICAL DESIGN) and document/database/Database_Standard_v2.0.docx.
// Credential/secret persistence, request params/payload, API/DB version, and
// Run/Snapshot/Comparison are explicitly deferred to Group 3B/3C — out of
// scope here. No new roles/permissions tables — reuses users.system_role and
// project_memberships (REQ-SEC-003 boundary).
//
// Group 3B — Request Input implementation.
// Source of truth: document/database/AnD_Database_Request_Input_3B.docx
// (status: FINAL/FROZEN DB baseline) and document/database/Database_Standard_v2.0.docx.
// Adds Request Input Definition persistence (QUERY/HEADER parameters, JSON
// Request Body definition) for an existing api_configurations row. Path
// Parameters are explicitly NOT persisted — api_configurations.path remains
// their sole source of truth (Section 5). Run Value, payload, credential and
// Authentication data remain out of scope in 3B.
//
// Group 3C — Authentication & Version implementation.
// Source of truth: document/requirement/03_API_Configuration/3C_Authentication_Version
// (REQ-SEC-002 CONFIRMED, REQ-AUTH-001/002/003 REVISED DRAFT) and the
// approved implementation plan (2026-09-21). Credential scope = api_id +
// environment_id + Authentication Configuration (REQ-SEC-002 Section 5); no
// row = auth_type NONE implicitly, same "no row = default state" convention
// as api_environment_configs. No Shared/Reusable Credential Library, no Copy
// Credential (MVP boundary). Secret values (password / bearer token) are
// encrypted at rest (AES-256-GCM, app-level key) and never returned in
// plaintext by any endpoint, to any actor. API/DB Version (REQ-VER-001) has
// no backend persistence in this scope — Run persistence is deferred, so
// Version stays a transient UI-only field (Run Preparation), not modeled here.
//
// Group Run — Run Execution implementation.
// Source of truth: document/requirement/04_Run (REQ-RUN-001..009, FINAL) and
// document/database/AnD_Database_Group_Run Section 17 corrected schema
// (DB-C01..C10 — treated as authoritative over the earlier uncorrected
// section) and Database_Standard_v2.0.docx. Adds `runs` (one row per
// accepted Single/Batch Execute) and `run_executions` (one row per API
// actually dispatched — Status, Outcome, API/DB Version frozen at
// acceptance, redacted Request/Response trace). Batch max-API-count is
// enforced at application layer, not a DB CHECK (DB-C01). Secret credential
// values are never written to run_executions — only the redacted/masked
// request trace is persisted (REQ-RUN-008 RS-008-15), reusing the existing
// AES-256-GCM credential decryption at dispatch time only, in memory.
// skip_reason_code's MISSING_REQUIRED_INPUT value is a Design Proposal: the
// business reason-code contract for the "Batch required-input skip"
// UX-agreed flow is not finalized (DC-01, UI_Requirement_Mapping_Group_Run
// Section 6) and may be renamed/extended by a future controlled migration.
// Snapshot/Comparison (SAME/DIFFERENT, Baseline/Target, field diff) remain
// explicitly out of scope — Run only stores Input and Output.
//
// Group 5 — Snapshot & History implementation.
// Source of truth: document/database/AnD_Database_Group_5_Snapshot_FINAL.docx
// and REQ-SNP-001..008/BA FINAL/Client Confirmed as applicable. Adds
// `snapshots` (at most one immutable row per run_execution, recognized
// complete only once its payload is saved in the same transaction),
// `snapshot_payloads` (1:1 full request/response body, no truncation, up to
// SNAPSHOT_MAX_PAYLOAD_BYTES per field — 25 MB), `snapshot_invalidations`
// (0..1 append-only audit row; presence = invalidated, same derived-status
// convention as user_sessions), and `snapshot_save_attempts` (0..N
// diagnostic event log per run_execution, no payload — the retry trail, not
// the authoritative "saved" signal). No `updated_at` on any of the four new
// tables — immutable/append-only, same convention as audit_logs. Eligibility
// is strictly HTTP 2xx (REQ-SNP-001/004/006), independently of
// run_executions.execution_outcome's broader RESPONSE_RECEIVED bucket (which
// also includes 3xx). "First vs. subsequent" Snapshot is derived at query
// time (ORDER BY completed_at, snapshot_id within the same
// api_id+environment_id+auth_context_key scope), not a stored flag.
// Authentication Configuration gains `context_version` (Group 5 Q5 answer):
// a stable identity/access-scope version, incremented on identity/access
// change but not on same-identity credential rotation, frozen into each
// Snapshot's auth_context_key at creation time — never the token/password
// itself, never rewritten on past Snapshots.
//
// Group 6/7 — Comparison Engine & Result/Classification implementation.
// Source of truth: document/database/AnD_Database_Group_6_7_Comparison_v0.3.md
// and REQ-CMP-001..018/REQ-ENV-004/REQ-OUT-002 (CMP-013..018 BA Proposed,
// CMP-002 Priority Should). Adds `comparison_chains` (chain-compare request
// identity), `comparisons` (one immutable row per A->B pair - Snapshot A is
// baseline, Snapshot B is target, CHECK-enforced A<>B), `comparison_attempts`
// (append-only processing/retry history per Comparison - at most one
// COMPLETED attempt per Comparison via a raw partial unique index),
// `comparison_findings` (output difference / input mismatch detail per
// attempt, never a copy of raw Snapshot bytes) and
// `comparison_classification_events` (append-only Expected/Unexpected
// history, latest revision wins). Extends `run_executions` with
// baseline_snapshot_id/baseline_selected_at/comparison_availability_reason_code
// (NO_BASELINE | NO_NEW_SNAPSHOT) - Execution-level availability, never a
// Comparison Result; no Comparison is ever created for a one-sided pair.
// Comparison's project_id/api_id/environment_id describe Snapshot A's scope
// only (RS-CMP-016-01) - intentionally NOT CHECK-enforced to match Snapshot
// B's scope, since a scope-mismatched pair must still persist as
// BLOCKED/CONTEXT_MISMATCH or BLOCKED/ENVIRONMENT_MISMATCH rather than be
// rejected at insert. source_execution_id uses a plain @unique (not a raw
// partial index): PostgreSQL treats multiple NULLs as distinct by default,
// which already satisfies "unique for AUTO_EXECUTION, NULL otherwise"
// without extra raw SQL, given the paired CHECK that ties source_kind =
// AUTO_EXECUTION to source_execution_id being NOT NULL. No policy/rule
// version master table exists yet in the repo (DB-VERIFY-03) -
// comparison_attempts.applied_rule_manifest is an application-level
// hardcoded default manifest at this DB phase, a known limitation. RESTRICT
// everywhere (no CASCADE), no `updated_at` on any of the 5 new tables - same
// immutable/append-only convention as audit_logs/snapshots.
//
// Scope: users, user_sessions, projects, project_memberships, audit_logs,
// api_configurations, environments, api_environment_configs,
// request_parameter_definitions, request_body_definitions,
// authentication_configurations, runs, run_executions, snapshots,
// snapshot_payloads, snapshot_invalidations, snapshot_save_attempts,
// comparison_chains, comparisons, comparison_attempts, comparison_findings,
// comparison_classification_events.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  userId          String  @id @default(uuid()) @map("user_id") @db.Uuid
  email           String  @unique @db.VarChar(320)
  googleSubjectId String? @unique @map("google_subject_id") @db.VarChar(255)
  systemRole      String  @map("system_role") @db.VarChar(20)

  // account_status: VARCHAR(30) length is a finalized Physical Design Decision
  // (approved 2026-09-11). Domain (INVITED, ACTIVE, INACTIVE, BLOCKED) and the
  // INVITED->ACTIVE transition are CONFIRMED (Database AnD Section 4.1/5,
  // updated 2026-09-14); enforced via a raw CHECK constraint
  // (ck_users_account_status, migration 20260914180000) not modeled here —
  // Prisma's declarative schema doesn't represent raw CHECK constraints, same
  // as the other 3 CHECK constraints from the initial migration. Other
  // ACTIVE/INACTIVE/BLOCKED transitions remain TBD.
  accountStatus String @map("account_status") @db.VarChar(30)

  activatedAt DateTime? @map("activated_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  note        String?   @db.Text

  sessions              UserSession[]
  memberships           ProjectMembership[]
  auditLogs             AuditLog[]
  runs                  Run[]
  snapshotsInitiated    Snapshot[]
  snapshotInvalidations SnapshotInvalidation[]

  comparisonChainsRequested      ComparisonChain[]
  comparisonsRequested           Comparison[]
  comparisonClassificationEvents ComparisonClassificationEvent[]

  @@map("users")
}

model UserSession {
  sessionId String @id @default(uuid()) @map("session_id") @db.Uuid

  userId String @map("user_id") @db.Uuid
  // onDelete: Restrict is a DESIGN PROPOSAL / interim physical decision
  // (approved 2026-09-11), not Requirement-confirmed.
  user   User   @relation(fields: [userId], references: [userId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // No DB default — session lifetime is application/config policy, not a
  // fixed DB-side value (Database Design Decision Proposal, 2026-09-11).
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revocationReason String?   @map("revocation_reason") @db.VarChar(255)
  note             String?   @db.Text

  // No `status` column. Session state is derived, not stored:
  //   revoked_at IS NOT NULL                     -> REVOKED
  //   revoked_at IS NULL AND now() >= expires_at  -> EXPIRED
  //   revoked_at IS NULL AND now() <  expires_at  -> ACTIVE

  @@map("user_sessions")
}

model Project {
  projectId String @id @default(uuid()) @map("project_id") @db.Uuid

  // Confirmed NOT UNIQUE — Database AnD (Project/Audit) Section 4 / REQ-PRJ-001:
  // project names may duplicate.
  projectName String @map("project_name") @db.VarChar(255)

  description String? @db.Text

  // NOT NULL, no SQL DEFAULT: "Initial: ACTIVE" is an Initial Business Value
  // (Database AnD Section 4 Notes: "not assumed SQL default"; Database
  // Standard v2.0 Section 14), set explicitly by application code on create —
  // same pattern already used for users.account_status.
  projectStatus String @map("project_status") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  // Soft delete. NULL = not deleted. No deleted_by column (Confirmed —
  // Database AnD Section 13: delete actor is traced through audit_logs).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  note      String?   @db.Text

  memberships  ProjectMembership[]
  auditLogs    AuditLog[]
  apis         ApiConfiguration[]
  environments Environment[]
  runs         Run[]
  snapshots    Snapshot[]

  comparisonChains ComparisonChain[]
  comparisons      Comparison[]

  @@index([projectStatus, deletedAt], map: "idx_projects_status_deleted")
  @@map("projects")
}

model ProjectMembership {
  userId    String @map("user_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  // Both onDelete: Restrict are DESIGN PROPOSAL / interim physical decisions
  // (approved 2026-09-11), not Requirement-confirmed.
  user    User    @relation(fields: [userId], references: [userId], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  note      String?  @db.Text

  @@id([userId, projectId], map: "pk_project_memberships")
  @@index([projectId], map: "idx_project_memberships_project_id")
  @@map("project_memberships")
}

// audit_logs — Database AnD (Project/Audit) Section 7/8/9. Append-only at
// application policy (no normal application Update/Delete); never stores
// password, secret or full token (Database Standard v2.0 Section 22).
model AuditLog {
  auditId String @id(map: "pk_audit_logs") @default(uuid()) @map("audit_id") @db.Uuid

  // No DB CHECK for event_type in this migration — taxonomy not yet frozen
  // (Database AnD Section 7/13, explicit instruction).
  eventType String @map("event_type") @db.VarChar(50)
  // CHECK ck_audit_logs_result: SUCCESS/FAILURE/DENIED.
  result    String @db.VarChar(20)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  // Nullable, ON DELETE SET NULL — audit history survives actor deletion.
  // actorDisplay is an intentional historical/searchable snapshot, kept even
  // if actorUserId is later nulled out.
  actorUserId  String? @map("actor_user_id") @db.Uuid
  actor        User?   @relation(fields: [actorUserId], references: [userId], onDelete: SetNull, map: "fk_audit_logs_actor_user_id")
  actorDisplay String? @map("actor_display") @db.VarChar(320)

  // Generic target: target_type + target_id, no polymorphic FK (Confirmed —
  // Database AnD Section 3/7).
  targetType    String? @map("target_type") @db.VarChar(50)
  targetId      String? @map("target_id") @db.VarChar(255)
  targetDisplay String? @map("target_display") @db.VarChar(320)

  // Nullable, ON DELETE SET NULL — audit history survives project deletion.
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [projectId], onDelete: SetNull, map: "fk_audit_logs_project_id")

  // PostgreSQL JSONB per Database AnD Section 7/9; sanitized before
  // persistence, never contains secrets/tokens/passwords.
  beforeData Json? @map("before_data") @db.JsonB
  afterData  Json? @map("after_data") @db.JsonB

  requestId String? @map("request_id") @db.VarChar(100)
  detail    String? @db.Text
  note      String? @db.Text

  // No index on `result` (explicit instruction). No automatic purge/retention
  // in this scope (Database AnD Section 9/13 — TBD, non-blocking).
  @@index([occurredAt(sort: Desc)], map: "idx_audit_logs_occurred_at")
  @@index([projectId, occurredAt(sort: Desc)], map: "idx_audit_logs_project_time")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "idx_audit_logs_actor_time")
  @@index([eventType, occurredAt(sort: Desc)], map: "idx_audit_logs_event_time")
  @@map("audit_logs")
}

// api_configurations — Database AnD (API & Environment Core 3A) Section 6.
// Active business identity = project_id + http_method + path (api_name is
// explicitly NOT part of it — REQ-FUN-002 FR-FUN-002-14/15). Soft delete via
// deleted_at preserves Run/Snapshot/Comparison history (REQ-FUN-001
// FR-FUN-001-09/10); a soft-deleted row must not block reuse of the same
// Method+Path. The active-uniqueness partial index (ux_api_configurations_active,
// scoped to deleted_at IS NULL) cannot be expressed declaratively in Prisma —
// added via raw SQL in the migration, same convention as the CHECK
// constraints below.
model ApiConfiguration {
  apiId String @id @default(uuid()) @map("api_id") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  apiName     String  @map("api_name") @db.VarChar(255)
  httpMethod  String  @map("http_method") @db.VarChar(10)
  path        String  @db.VarChar(2048)
  description String? @db.Text

  // creation_source domain: MANUAL | OPENAPI_IMPORT (REQ-FUN-002). Enforced
  // via raw CHECK ck_api_configurations_creation_source, not modeled here.
  creationSource String @map("creation_source") @db.VarChar(30)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  // Soft delete. NULL = active. No deleted_by column (same convention as
  // projects — delete actor traced through audit_logs).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  note      String?   @db.Text

  configs ApiEnvironmentConfig[]

  parameterDefinitions RequestParameterDefinition[]
  bodyDefinition       RequestBodyDefinition?
  authConfigs          AuthenticationConfiguration[]
  runExecutions        RunExecution[]
  snapshots            Snapshot[]
  comparisonChains     ComparisonChain[]
  comparisons          Comparison[]

  @@index([projectId, deletedAt], map: "idx_api_configurations_project_deleted")
  @@map("api_configurations")
}

// environments — Database AnD (API & Environment Core 3A) Section 7/8.
// Identity within a Project = project_id + environment_name (unique,
// case-insensitive after trim — REQ-ENV-001 FR-ENV-001-05/06 — including
// INACTIVE rows). No hard delete; ACTIVE/INACTIVE lifecycle only
// (environment_status), independent of allow_run (REQ-ENV-003). The
// case-insensitive unique index (ux_environments_project_name_ci) cannot be
// expressed declaratively in Prisma — added via raw SQL in the migration.
// classification (PRODUCTION/NON_PRODUCTION) is independent of
// environment_name (REQ-ENV-001 FR-ENV-001-12); default Allow Run
// ON/OFF-by-classification and the atomic non-Prod->Prod OFF-forcing
// transition (REQ-ENV-003) are application business logic, not DB defaults.
model Environment {
  environmentId String @id @default(uuid()) @map("environment_id") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  environmentName String @map("environment_name") @db.VarChar(100)

  // classification domain: PRODUCTION | NON_PRODUCTION. Enforced via raw
  // CHECK ck_environments_classification, not modeled here.
  classification String @db.VarChar(20)

  allowRun Boolean @map("allow_run")

  // environment_status domain: ACTIVE | INACTIVE. Enforced via raw CHECK
  // ck_environments_environment_status, not modeled here.
  environmentStatus String @map("environment_status") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  note      String?  @db.Text

  configs          ApiEnvironmentConfig[]
  authConfigs      AuthenticationConfiguration[]
  runs             Run[]
  snapshots        Snapshot[]
  comparisonChains ComparisonChain[]
  comparisons      Comparison[]

  @@index([projectId], map: "idx_environments_project_id")
  @@map("environments")
}

// api_environment_configs — Database AnD (API & Environment Core 3A) Section 9,
// DEC-3A-DB-001 (CONFIRMED): no row = Not configured; a row exists only after
// Full URL is successfully saved, so full_url is NOT NULL. Relationship
// identity = (api_id, environment_id). FK delete behavior kept RESTRICT
// (not CASCADE) per the frozen AnD's history-preserving instruction
// (TBD-3A-DB-002 — exact downstream Run/Snapshot behavior deferred, but
// CASCADE is explicitly disallowed in the interim).
model ApiEnvironmentConfig {
  apiId         String           @map("api_id") @db.Uuid
  api           ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)
  environmentId String           @map("environment_id") @db.Uuid
  environment   Environment      @relation(fields: [environmentId], references: [environmentId], onDelete: Restrict)

  fullUrl String @map("full_url") @db.VarChar(4096)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  note      String?  @db.Text

  @@id([apiId, environmentId], map: "pk_api_environment_configs")
  @@index([environmentId], map: "idx_api_environment_configs_environment_id")
  @@map("api_environment_configs")
}

// request_parameter_definitions — Database AnD (Request Input 3B) Section 6/7/12.
// Definition-only: QUERY/HEADER parameter name + Required/Optional state that
// the User configures for an API. No Run Value, credential, default value or
// advanced schema metadata (REQ-INP-003 RS-06/BR-INP-003-24; REQ-INP-004).
// PATH parameters are intentionally NOT modeled here — api_configurations.path
// remains their sole source of truth (Section 5, DB-STD-02 Single Source of
// Truth). Definition is API-level and shared across Environments (no
// environment_id column — BR-INP-003-21/25).
//
// Uniqueness (DB-3B-PAR-01..04) needs two different case sensitivities for
// the same (api_id, parameter_name) shape depending on location, which
// Prisma's declarative `@@unique` cannot express as partial/functional
// indexes — added via raw SQL in the migration:
//   - QUERY: case-sensitive unique on (api_id, parameter_name)
//   - HEADER: case-insensitive unique on (api_id, lower(parameter_name))
// A QUERY and a HEADER definition may share the same spelling because
// location is part of the uniqueness boundary (DB-3B-PAR-04).
model RequestParameterDefinition {
  requestParameterDefinitionId String @id @default(uuid()) @map("request_parameter_definition_id") @db.Uuid

  apiId String           @map("api_id") @db.Uuid
  api   ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)

  // location domain: QUERY | HEADER. Enforced via raw CHECK
  // ck_request_parameter_definitions_location, not modeled here. PATH/BODY
  // are never persisted as parameter rows (Section 12).
  location String @db.VarChar(20)

  parameterName String @map("parameter_name") @db.VarChar(255)

  isRequired Boolean @map("is_required")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  note      String?  @db.Text

  @@index([apiId, location], map: "idx_request_parameter_definitions_api_id_location")
  @@map("request_parameter_definitions")
}

// request_body_definitions — Database AnD (Request Input 3B) Section 8/9/12.
// 0..1 per API (api_id UNIQUE): whether the API has a Request Body and which
// Body Type. MVP supports only body_type = JSON; the field is named
// generically so future body types can be added by a controlled migration
// without renaming (AD-INP-005-01). Never stores the JSON payload itself —
// Run Payload persistence belongs to Run/Snapshot scope (REQ-INP-004/005).
model RequestBodyDefinition {
  requestBodyDefinitionId String @id @default(uuid()) @map("request_body_definition_id") @db.Uuid

  apiId String           @unique @map("api_id") @db.Uuid
  api   ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)

  // body_type domain: JSON only in MVP. Enforced via raw CHECK
  // ck_request_body_definitions_body_type, not modeled here. Generic naming
  // per AD-INP-005-01 to allow controlled future expansion.
  bodyType String @map("body_type") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  note      String?  @db.Text

  @@map("request_body_definitions")
}

// authentication_configurations — Group 3C (REQ-SEC-002 CONFIRMED,
// REQ-AUTH-001/002/003). No row = auth_type NONE implicitly, same "no row =
// Not configured" convention as api_environment_configs. Relationship
// identity = (api_id, environment_id) — credential isolation boundary per
// REQ-SEC-002 Section 5; never shared/copied across API or Environment.
//
// LOGIN_FORM non-secret config (login_url, username, username_field,
// password_field, token_response_path) is Credential Metadata per
// REQ-SEC-002's terminology table and may be read by Admin and User with
// Project Access. The secret columns below are Secret Credential Value and
// are NEVER returned in plaintext by any endpoint, to any actor — only
// Configured/Not configured status is exposed. Exactly one secret pair is
// populated at a time, matching the currently selected auth_type; switching
// auth_type (CL-3C-02, REQ-AUTH-003) clears the previous type's secret in
// the same mutation.
model AuthenticationConfiguration {
  apiId         String           @map("api_id") @db.Uuid
  api           ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)
  environmentId String           @map("environment_id") @db.Uuid
  environment   Environment      @relation(fields: [environmentId], references: [environmentId], onDelete: Restrict)

  // auth_type domain: NONE | LOGIN_FORM | BEARER_TOKEN. Enforced via raw
  // CHECK ck_authentication_configurations_auth_type, not modeled here.
  authType String @map("auth_type") @db.VarChar(20)

  // Stable identity/access-scope version for this API+Environment's
  // Authentication Configuration (REQ-SNP-003/006/008, Group 5 Q5 answer).
  // Incremented when identity or access materially changes (auth_type
  // change, LOGIN_FORM username change, credential removal, or a
  // BEARER_TOKEN replacement not explicitly confirmed as the same
  // identity/access); NOT incremented for a same-identity credential
  // rotation. Frozen onto each Snapshot at creation time as part of
  // auth_context_key — never rewritten retroactively on past Snapshots.
  contextVersion Int @default(1) @map("context_version")

  // LOGIN_FORM config — non-secret, null unless auth_type = LOGIN_FORM.
  loginUrl          String? @map("login_url") @db.VarChar(2048)
  username          String? @db.VarChar(255)
  usernameField     String? @map("username_field") @db.VarChar(100)
  passwordField     String? @map("password_field") @db.VarChar(100)
  tokenResponsePath String? @map("token_response_path") @db.VarChar(200)

  // Secret, encrypted at rest (AES-256-GCM, app-level CREDENTIAL_ENCRYPTION_KEY).
  // Populated only when auth_type = LOGIN_FORM and a password has been set.
  passwordCiphertext Bytes? @map("password_ciphertext")
  passwordIv         Bytes? @map("password_iv")
  passwordAuthTag    Bytes? @map("password_auth_tag")

  // Secret, encrypted at rest. Populated only when auth_type = BEARER_TOKEN
  // and a token has been set.
  bearerTokenCiphertext Bytes? @map("bearer_token_ciphertext")
  bearerTokenIv         Bytes? @map("bearer_token_iv")
  bearerTokenAuthTag    Bytes? @map("bearer_token_auth_tag")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  note      String?  @db.Text

  @@id([apiId, environmentId], map: "pk_authentication_configurations")
  @@index([environmentId], map: "idx_authentication_configurations_environment_id")
  @@map("authentication_configurations")
}

// runs — Group Run, document/database/AnD_Database_Group_Run Section 17
// (DB-C01..C10 corrected). One row per accepted Single or Batch Execute
// (REQ-RUN-001). Single = exactly 1 RunExecution; Batch = up to the
// application-enforced max (DB-C01 — not a DB CHECK). Immutable history:
// no application Update/Delete once created, no soft delete.
model Run {
  runId String @id @default(uuid()) @map("run_id") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  environmentId String      @map("environment_id") @db.Uuid
  environment   Environment @relation(fields: [environmentId], references: [environmentId], onDelete: Restrict)

  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation(fields: [createdBy], references: [userId], onDelete: Restrict)

  // run_type domain: SINGLE | BATCH. Enforced via raw CHECK
  // ck_runs_run_type, not modeled here.
  runType String @map("run_type") @db.VarChar(20)

  // run_status domain: PENDING | RUNNING | COMPLETED | INTERRUPTED
  // (Run/Batch-level rollup — SKIPPED/NOT_EXECUTED exist only at the
  // RunExecution level, REQ-RUN-007). Enforced via raw CHECK
  // ck_runs_run_status. NOT NULL, no SQL default — set explicitly by
  // application code at acceptance (PENDING), same convention as
  // projects.project_status / users.account_status.
  runStatus String @map("run_status") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  startedAt DateTime? @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz
  note      String?   @db.Text

  executions RunExecution[]
  snapshots  Snapshot[]

  @@index([projectId, createdAt(sort: Desc)], map: "idx_runs_project_id_created_at")
  @@map("runs")
}

// run_executions — Group Run, document/database/AnD_Database_Group_Run
// Section 17 (DB-C01..C10 corrected). One row per API actually dispatched
// within a Run (Single or Batch child). Status and Outcome are
// intentionally separate columns (REQ-RUN-007/008 BR-02): Status tracks
// lifecycle (PENDING/RUNNING/COMPLETED/SKIPPED/INTERRUPTED/NOT_EXECUTED),
// Outcome tracks result classification (RESPONSE_RECEIVED/RUN_ERROR/
// SKIPPED). Request/Response trace columns are populated only once actually
// dispatched, already redacted/masked (REQ-RUN-008 RS-008-15) — never the
// real secret credential value. Immutable history once written.
model RunExecution {
  runExecutionId String @id @default(uuid()) @map("run_execution_id") @db.Uuid

  runId String @map("run_id") @db.Uuid
  run   Run    @relation(fields: [runId], references: [runId], onDelete: Restrict)

  apiId String           @map("api_id") @db.Uuid
  api   ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)

  // 1-based position within the Run's selection order (Single is always 1).
  // Enforced >= 1 via raw CHECK ck_run_executions_execution_order.
  executionOrder Int @map("execution_order")

  // execution_status domain: PENDING | RUNNING | COMPLETED | SKIPPED |
  // INTERRUPTED | NOT_EXECUTED. Enforced via raw CHECK
  // ck_run_executions_execution_status, not modeled here.
  executionStatus String @map("execution_status") @db.VarChar(20)

  // execution_outcome domain: RESPONSE_RECEIVED | RUN_ERROR | SKIPPED.
  // Nullable — no outcome yet while PENDING/RUNNING, and INTERRUPTED/
  // NOT_EXECUTED never receive one (REQ-RUN-007/008 BR-02). Enforced via raw
  // CHECK ck_run_executions_execution_outcome.
  executionOutcome String? @map("execution_outcome") @db.VarChar(20)

  // skip_reason_code: CONFIRMED value is MISSING_FULL_URL (REQ-RUN-001
  // RS-001-08 — Batch-only; missing Full URL never blocks Batch acceptance,
  // the API is SKIPPED instead, no request sent). MISSING_REQUIRED_INPUT is
  // a Design Proposal for the UX-agreed "review & confirm skip" flow (DC-01,
  // UI_Requirement_Mapping_Group_Run Section 6) — not finalized, may be
  // renamed/extended by a future controlled migration. Enforced via raw
  // CHECK ck_run_executions_skip_reason_code.
  skipReasonCode String? @map("skip_reason_code") @db.VarChar(50)

  // error_reason_code: set only when execution_outcome = RUN_ERROR.
  // HTTP_ERROR covers HTTP 4xx/5xx (REQ-RUN-002, http_status populated); the
  // other 5 values cover transport failures with no HTTP response
  // (REQ-RUN-003, http_status null). Enforced via raw CHECK
  // ck_run_executions_error_reason_code.
  errorReasonCode  String? @map("error_reason_code") @db.VarChar(50)
  errorMessageSafe String? @map("error_message_safe") @db.Text

  // API/Database Version (REQ-RUN-009). NOT NULL, no SQL default — app
  // resolves manual > configured-if-supported > UNKNOWN and freezes the
  // value at Execute acceptance; never rewritten for an existing Run.
  apiVersion      String @map("api_version") @db.VarChar(100)
  databaseVersion String @map("database_version") @db.VarChar(100)

  // Actual Request trace (REQ-RUN-008 RS-008-05), already redacted/masked
  // before persistence (RS-008-15). Null until the request is actually
  // dispatched — never populated for SKIPPED/NOT_EXECUTED (RS-008-09).
  requestMethod      String?   @map("request_method") @db.VarChar(10)
  requestUrlSafe     String?   @map("request_url_safe") @db.VarChar(4096)
  requestQuerySafe   Json?     @map("request_query_safe") @db.JsonB
  requestHeadersSafe Json?     @map("request_headers_safe") @db.JsonB
  requestBodySafe    String?   @map("request_body_safe") @db.Text
  requestContentType String?   @map("request_content_type") @db.VarChar(255)
  requestSentAt      DateTime? @map("request_sent_at") @db.Timestamptz

  // Actual HTTP Response trace (REQ-RUN-008 RS-008-06). http_status is null
  // when no response was ever received (transport failure, REQ-RUN-003).
  httpStatus          Int?    @map("http_status")
  responseHeadersSafe Json?   @map("response_headers_safe") @db.JsonB
  responseBodySafe    String? @map("response_body_safe") @db.Text
  responseContentType String? @map("response_content_type") @db.VarChar(255)

  // response_body_kind domain: TEXT | BINARY (REQ-RUN-008 BR-11: JSON and
  // other text are both stored as TEXT; binary/file responses persist
  // metadata only, never the body — RS-008-18). Enforced via raw CHECK
  // ck_run_executions_response_body_kind.
  responseBodyKind String? @map("response_body_kind") @db.VarChar(20)

  // NOT NULL — the app always states explicitly whether the stored body was
  // cut, never left to a DB default (same "no silent default" convention as
  // environments.allow_run).
  responseBodyIsTruncated Boolean   @map("response_body_is_truncated")
  responseBodySizeBytes   Int?      @map("response_body_size_bytes")
  responseBodyStoredBytes Int?      @map("response_body_stored_bytes")
  responseReceivedAt      DateTime? @map("response_received_at") @db.Timestamptz

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  startedAt  DateTime? @map("started_at") @db.Timestamptz
  endedAt    DateTime? @map("ended_at") @db.Timestamptz
  durationMs Int?      @map("duration_ms")
  note       String?   @db.Text

  // Group 6/7 Comparison - baseline chosen right before dispatch (CMP-003/013,
  // AnD Section 4.1); never reselected once set. NULL baseline_snapshot_id
  // means no baseline was available at Execution time, never a fabricated
  // ID. baseline_selected_at proves the "chosen before dispatch" ordering
  // independently of requestSentAt. comparison_availability_reason_code is
  // Execution-level availability only (NO_BASELINE | NO_NEW_SNAPSHOT,
  // ck_run_executions_comparison_availability_reason_code) - never a
  // Comparison Result, and NULL whenever both a baseline and an eligible
  // target Snapshot exist.
  baselineSnapshotId               String?   @map("baseline_snapshot_id") @db.Uuid
  baselineSnapshot                 Snapshot? @relation("RunExecutionBaselineSnapshot", fields: [baselineSnapshotId], references: [snapshotId], onDelete: Restrict)
  baselineSelectedAt               DateTime? @map("baseline_selected_at") @db.Timestamptz
  comparisonAvailabilityReasonCode String?   @map("comparison_availability_reason_code") @db.VarChar(32)

  snapshot            Snapshot?             @relation("RunExecutionTargetSnapshot")
  saveAttempts        SnapshotSaveAttempt[]
  comparisonsAsSource Comparison[]

  @@unique([runId, apiId], map: "uq_run_executions_run_id_api_id")
  @@unique([runId, executionOrder], map: "uq_run_executions_run_id_execution_order")
  @@index([apiId, createdAt(sort: Desc)], map: "idx_run_executions_api_id_created_at")
  @@index([baselineSnapshotId], map: "idx_run_executions_baseline_snapshot_id")
  @@map("run_executions")
}

// snapshots — Group 5 Snapshot & History, document/database/AnD_Database_Group_5_Snapshot_FINAL.docx
// and REQ-SNP-001/002/003/004/006/008. At most one Snapshot per RunExecution
// (uq_snapshots_run_execution_id — the DB-level guarantee for REQ-SNP-006
// RS-SNP-006-05 Execution Uniqueness). Recognized "completed" only once this
// row and its SnapshotPayload are written together in the same transaction
// (SNP-002 RS-SNP-002-01 completion boundary) — a row here with no payload
// row never happens; a failed save writes only a SnapshotSaveAttempt, never
// a Snapshot. Immutable once written: no application Update/Delete, no
// updated_at column (same convention as AuditLog). Eligibility for creating
// a Snapshot at all is strictly HTTP 2xx (SNP-001/004/006) — narrower than
// run_executions.execution_outcome's RESPONSE_RECEIVED bucket, which also
// includes 3xx. "First vs. subsequent" is derived at query time (ORDER BY
// completed_at, snapshot_id within the same
// api_id+environment_id+auth_context_key scope, idx_snapshots_scope_completed_at)
// rather than stored as a flag, so the meaning never needs retroactive
// correction if history is reinterpreted.
model Snapshot {
  snapshotId String @id @default(uuid()) @map("snapshot_id") @db.Uuid

  runExecutionId String       @unique(map: "uq_snapshots_run_execution_id") @map("run_execution_id") @db.Uuid
  runExecution   RunExecution @relation("RunExecutionTargetSnapshot", fields: [runExecutionId], references: [runExecutionId], onDelete: Restrict)

  runId String @map("run_id") @db.Uuid
  run   Run    @relation(fields: [runId], references: [runId], onDelete: Restrict)

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  apiId String           @map("api_id") @db.Uuid
  api   ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)

  environmentId String      @map("environment_id") @db.Uuid
  environment   Environment @relation(fields: [environmentId], references: [environmentId], onDelete: Restrict)

  // Historical context (REQ-SNP-003 RS-SNP-003-03): identifying names frozen
  // at execution time, so a later rename of the Project/API/Environment does
  // not retroactively alter what this Snapshot's history shows.
  projectNameAtExecution     String @map("project_name_at_execution") @db.VarChar(255)
  apiNameAtExecution         String @map("api_name_at_execution") @db.VarChar(255)
  environmentNameAtExecution String @map("environment_name_at_execution") @db.VarChar(100)

  // Authentication Context (REQ-SNP-003 RS-SNP-003-04, REQ-SNP-006
  // RS-SNP-006-01/07, Group 5 Q5 answer). auth_type mirrors
  // authentication_configurations.auth_type's domain (raw CHECK
  // ck_snapshots_auth_type). auth_context_version is the
  // AuthenticationConfiguration.context_version value at the moment this
  // Snapshot was created — frozen here, never rewritten as the live
  // configuration's context_version later changes. auth_identity_label is a
  // non-secret identity hint (LOGIN_FORM username, or null for NONE/
  // BEARER_TOKEN) for display only — never the credential itself.
  // auth_context_key is the computed SHA-256 fingerprint
  // (computeAuthContextKey) used to scope "same context" comparisons; it
  // never includes the token/password value.
  authType           String  @map("auth_type") @db.VarChar(20)
  authContextVersion Int     @map("auth_context_version")
  authIdentityLabel  String? @map("auth_identity_label") @db.VarChar(255)
  authContextKey     String  @map("auth_context_key") @db.VarChar(64)

  initiatedByUserId String @map("initiated_by_user_id") @db.Uuid
  initiatedBy       User   @relation(fields: [initiatedByUserId], references: [userId], onDelete: Restrict)
  initiatedByLabel  String @map("initiated_by_label") @db.VarChar(320)

  // Actual Request (REQ-SNP-003 RS-SNP-003-05, REQ-SNP-004 RS-SNP-004-02),
  // taken after Request Assembly — the same source RunExecution already
  // captured, not the Request Input Definition.
  httpMethod           String  @map("http_method") @db.VarChar(10)
  requestUrl           String  @map("request_url") @db.VarChar(4096)
  requestContentType   String? @map("request_content_type") @db.VarChar(255)
  // Request headers actually sent for this Execution (REQ-SNP-003 §C),
  // added by a later migration than the rest of this table. Same shape and
  // redaction convention as run_executions.request_headers_safe — the
  // Authorization value is masked, every other header is stored as typed by
  // the user. Null for any Snapshot created before this column existed.
  requestHeaders       Json?   @map("request_headers") @db.JsonB
  requestBodySizeBytes Int?    @map("request_body_size_bytes")

  // Actual Response (REQ-SNP-003 RS-SNP-003-06, REQ-SNP-004). http_status_code
  // is constrained to the 200-299 eligibility range at the DB layer
  // (ck_snapshots_http_status_code) — a Snapshot is only ever created for a
  // 2xx Execution (SNP-001/004/006), so this is a redundant-by-design
  // guarantee, not a new business rule. response_completeness distinguishes
  // a full body from a partial HTTP 206 range (REQ-SNP-004 RS-SNP-004-12);
  // content_range_header carries the Content-Range value when present.
  httpStatusCode        Int?    @map("http_status_code")
  responseContentType   String? @map("response_content_type") @db.VarChar(255)
  // Response headers actually received for this Execution (REQ-SNP-003
  // §D), added by the same later migration as request_headers. Unredacted,
  // same shape as run_executions.response_headers_safe. Null for any
  // Snapshot created before this column existed.
  responseHeaders       Json?   @map("response_headers") @db.JsonB
  responseBodySizeBytes Int?    @map("response_body_size_bytes")
  responseCompleteness  String  @map("response_completeness") @db.VarChar(20)
  contentRangeHeader    String? @map("content_range_header") @db.VarChar(255)

  // Time (REQ-SNP-003 Section 5.E). requested_at/started_at are only ever
  // populated when the source RunExecution has a real value for them — never
  // fabricated (RS-SNP-003-08). completed_at is required and drives the
  // "first Snapshot" ordering.
  requestedAt DateTime? @map("requested_at") @db.Timestamptz
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime  @map("completed_at") @db.Timestamptz
  durationMs  Int?      @map("duration_ms")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // API/Database Version of the source Execution (REQ-SNP-003
  // RS-SNP-003-09) — same VARCHAR(100) NOT NULL shape as
  // run_executions.api_version/database_version; "UNKNOWN" is a business
  // value written by the application, not a DB default.
  apiVersion      String @map("api_version") @db.VarChar(100)
  databaseVersion String @map("database_version") @db.VarChar(100)

  // Execution Outcome (REQ-SNP-003 RS-SNP-003-11) — kept distinct from
  // http_status_code per the same Status/Outcome separation as
  // run_executions. Reuses run_executions' execution_outcome value domain
  // (ck_snapshots_execution_outcome mirrors ck_run_executions_execution_outcome).
  executionOutcome String @map("execution_outcome") @db.VarChar(20)

  payload      SnapshotPayload?
  invalidation SnapshotInvalidation?

  // Group 6/7 Comparison back-relations - a Snapshot may be the baseline
  // chosen for 0..N later Executions, and/or Snapshot A or Snapshot B of
  // 0..N Comparisons (AnD Section 2 cardinality table).
  baselineForExecutions RunExecution[] @relation("RunExecutionBaselineSnapshot")
  comparisonsAsBaseline Comparison[]   @relation("ComparisonBaselineSnapshot")
  comparisonsAsTarget   Comparison[]   @relation("ComparisonTargetSnapshot")

  @@index([apiId, environmentId, authContextKey, completedAt], map: "idx_snapshots_scope_completed_at")
  @@index([runId], map: "idx_snapshots_run_id")
  @@index([projectId, createdAt(sort: Desc)], map: "idx_snapshots_project_created_at")
  @@map("snapshots")
}

// snapshot_payloads — true 1:1 with snapshots, split out so the large BYTEA
// request/response bodies sit off the frequently-scanned snapshots row.
// Written in the same DB transaction as its parent Snapshot (SNP-004 BR-06 /
// EXC-02) — a partial write can never produce a recognized-complete
// Snapshot without its payload. A nullable Bytes column losslessly
// represents all three body states required by REQ-SNP-004 RS-SNP-004-11:
// NULL = absent, zero-length = empty, 4-byte "null" = JSON null content —
// no separate state enum column is needed.
model SnapshotPayload {
  snapshotId String   @id @map("snapshot_id") @db.Uuid
  snapshot   Snapshot @relation(fields: [snapshotId], references: [snapshotId], onDelete: Restrict)

  requestBody  Bytes? @map("request_body")
  responseBody Bytes? @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("snapshot_payloads")
}

// snapshot_invalidations — 0..1 per Snapshot, append-only audit row (REQ-SNP-002
// RS-SNP-002-06/07). Presence of this row IS the "Invalidated" signal — same
// derived-status convention as user_sessions (no status column there
// either). Never updated or removed once written; the original Snapshot
// content is never rewritten alongside it.
model SnapshotInvalidation {
  invalidationId String @id @default(uuid()) @map("invalidation_id") @db.Uuid

  snapshotId String   @unique(map: "uq_snapshot_invalidations_snapshot_id") @map("snapshot_id") @db.Uuid
  snapshot   Snapshot @relation(fields: [snapshotId], references: [snapshotId], onDelete: Restrict)

  reason String @db.Text

  invalidatedByUserId String @map("invalidated_by_user_id") @db.Uuid
  invalidatedBy       User   @relation(fields: [invalidatedByUserId], references: [userId], onDelete: Restrict)
  invalidatedByLabel  String @map("invalidated_by_label") @db.VarChar(320)

  invalidatedAt DateTime @default(now()) @map("invalidated_at") @db.Timestamptz

  @@map("snapshot_invalidations")
}

// snapshot_save_attempts — 0..N per RunExecution, diagnostic event log only
// (REQ-SNP-005 RS-SNP-005-10, REQ-SNP-006 RS-SNP-006-09/10). NOT the
// authoritative "saved" signal — that is the existence of a snapshots (+
// snapshot_payloads) row. No payload here, ever. Many rows are expected for
// a single RunExecution across retries (EXC-02); this table intentionally
// has no unique constraint on run_execution_id.
model SnapshotSaveAttempt {
  attemptId String @id @default(uuid()) @map("attempt_id") @db.Uuid

  runExecutionId String       @map("run_execution_id") @db.Uuid
  runExecution   RunExecution @relation(fields: [runExecutionId], references: [runExecutionId], onDelete: Restrict)

  // attempt_status domain: SUCCEEDED | FAILED. Enforced via raw CHECK
  // ck_snapshot_save_attempts_attempt_status, not modeled here.
  attemptStatus String @map("attempt_status") @db.VarChar(20)

  errorReasonCode String? @map("error_reason_code") @db.VarChar(50)
  errorDetail     String? @map("error_detail") @db.Text

  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz

  @@index([runExecutionId, attemptedAt], map: "idx_snapshot_save_attempts_execution_time")
  @@map("snapshot_save_attempts")
}

// comparison_chains - Group 6/7, document/database/AnD_Database_Group_6_7_Comparison_v0.3.md
// Section 4.2. Identity of a chain-compare request: only a request with at
// least 2 Snapshots is ever persisted, and its ordered pairs are the
// `comparisons` rows sharing this comparison_chain_id (pair_ordinal is the
// order, no duplicate JSON array is stored here). No whole-chain status/
// Result column - progress, if ever needed by UI, is derived from the
// member pairs' attempt status (CMP-004/016).
model ComparisonChain {
  comparisonChainId String @id @default(uuid()) @map("comparison_chain_id") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  apiId String           @map("api_id") @db.Uuid
  api   ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)

  environmentId String      @map("environment_id") @db.Uuid
  environment   Environment @relation(fields: [environmentId], references: [environmentId], onDelete: Restrict)

  requestedByUserId String @map("requested_by") @db.Uuid
  requestedBy       User   @relation(fields: [requestedByUserId], references: [userId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  note      String?  @db.Text

  comparisons Comparison[]

  @@index([projectId, createdAt(sort: Desc)], map: "idx_comparison_chains_project_id_created_at")
  @@map("comparison_chains")
}

// comparisons - Group 6/7 Section 4.3/6.1. One immutable row per A->B pair;
// A is always Snapshot baseline, B is always Snapshot target
// (ck_comparisons_baseline_target_distinct: A<>B). project_id/api_id/
// environment_id describe **Snapshot A's scope only** (RS-CMP-016-01) -
// taken from Snapshot A at creation time, never authoritative for B and
// never accepted from the frontend. A pair that fails the CMP-005 scope/
// auth-context gate still persists here with status BLOCKED and a reason on
// its ComparisonAttempt: this table deliberately has **no CHECK** forcing
// A/B to share scope, matching AnD's explicit instruction not to block
// insert on that gate. source_execution_id is required and unique for
// source_kind = AUTO_EXECUTION only (ck_comparisons_source_execution_id) -
// a plain @unique is enough because PostgreSQL already treats multiple NULLs
// as distinct, satisfying "unique for AUTO, NULL otherwise" without a raw
// partial index. comparison_chain_id/pair_ordinal are required together for
// source_kind = CHAIN_PAIR only (ck_comparisons_chain_fields), unique per
// chain (uq_comparisons_chain_id_pair_ordinal).
model Comparison {
  comparisonId String @id @default(uuid()) @map("comparison_id") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  apiId String           @map("api_id") @db.Uuid
  api   ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)

  environmentId String      @map("environment_id") @db.Uuid
  environment   Environment @relation(fields: [environmentId], references: [environmentId], onDelete: Restrict)

  baselineSnapshotId String   @map("baseline_snapshot_id") @db.Uuid
  baselineSnapshot   Snapshot @relation("ComparisonBaselineSnapshot", fields: [baselineSnapshotId], references: [snapshotId], onDelete: Restrict)

  targetSnapshotId String   @map("target_snapshot_id") @db.Uuid
  targetSnapshot   Snapshot @relation("ComparisonTargetSnapshot", fields: [targetSnapshotId], references: [snapshotId], onDelete: Restrict)

  // source_kind domain: AUTO_EXECUTION | MANUAL_PAIR | BASELINE_LATEST |
  // CHAIN_PAIR. BASELINE_LATEST is a manual subtype, never merged with
  // automatic. Enforced via raw CHECK ck_comparisons_source_kind.
  sourceKind String @map("source_kind") @db.VarChar(32)

  sourceExecutionId String?       @unique(map: "uq_comparisons_source_execution_id") @map("source_execution_id") @db.Uuid
  sourceExecution   RunExecution? @relation(fields: [sourceExecutionId], references: [runExecutionId], onDelete: Restrict)

  comparisonChainId String?          @map("comparison_chain_id") @db.Uuid
  comparisonChain   ComparisonChain? @relation(fields: [comparisonChainId], references: [comparisonChainId], onDelete: Restrict)
  // 1-based order within the chain. Required together with
  // comparison_chain_id (ck_comparisons_chain_fields); > 0 when present
  // (ck_comparisons_pair_ordinal).
  pairOrdinal       Int?             @map("pair_ordinal")

  // Actor for MANUAL_PAIR/BASELINE_LATEST/CHAIN_PAIR; NULL for
  // AUTO_EXECUTION (system-originated, no user actor). Design Proposal
  // (AnD Section 4.3).
  requestedByUserId String? @map("requested_by") @db.Uuid
  requestedBy       User?   @relation(fields: [requestedByUserId], references: [userId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  note      String?  @db.Text

  attempts             ComparisonAttempt[]
  classificationEvents ComparisonClassificationEvent[]

  @@unique([comparisonChainId, pairOrdinal], map: "uq_comparisons_chain_id_pair_ordinal")
  @@index([baselineSnapshotId], map: "idx_comparisons_baseline_snapshot_id")
  @@index([targetSnapshotId], map: "idx_comparisons_target_snapshot_id")
  @@index([projectId, apiId, createdAt(sort: Desc)], map: "idx_comparisons_project_id_api_id_created_at")
  @@map("comparisons")
}

// comparison_attempts - Group 6/7 Section 4.4/5/6.1. Append-only
// processing/retry history per Comparison (uq_comparison_attempts_comparison_id_attempt_number,
// attempt_number > 0). `COMPLETED <=> comparison_result IN (SAME, DIFFERENT)`
// is enforced by cross-field CHECK ck_comparison_attempts_completed_result;
// every other status keeps comparison_result NULL. A raw partial unique
// index (uq_comparison_attempts_completed_per_comparison, migration-only -
// Prisma cannot express a partial index declaratively, same convention as
// ApiConfiguration's active-uniqueness index) guarantees at most one
// COMPLETED attempt per Comparison at the DB layer; retries never update a
// terminal attempt. applied_rule_manifest is an immutable snapshot of the
// rule/version/policy/exclusion/representation boundary used by this
// attempt (CMP-006/007/008/016/017/018) - no policy/version master table
// exists yet in the repo (DB-VERIFY-03), so the application writes a
// hardcoded default manifest here as a known limitation.
model ComparisonAttempt {
  comparisonAttemptId String @id @default(uuid()) @map("comparison_attempt_id") @db.Uuid

  comparisonId String     @map("comparison_id") @db.Uuid
  comparison   Comparison @relation(fields: [comparisonId], references: [comparisonId], onDelete: Restrict)

  attemptNumber Int @map("attempt_number")

  // processing_status domain: QUEUED | RUNNING | BLOCKED | FAILED |
  // COMPLETED. Enforced via raw CHECK ck_comparison_attempts_processing_status.
  processingStatus String @map("processing_status") @db.VarChar(20)

  // stopped_at_gate domain (Design Proposal - AnD names the 4 gate concepts
  // but does not freeze exact tokens, Section 4.4): ELIGIBILITY | INPUT |
  // OUTPUT | PERSISTENCE. NULL while not yet stopped. Enforced via raw CHECK
  // ck_comparison_attempts_stopped_at_gate.
  stoppedAtGate String? @map("stopped_at_gate") @db.VarChar(20)

  // reason_code domain per AnD Section 5 (one primary reason per first
  // stopping gate) - CONTEXT_MISMATCH/ENVIRONMENT_MISMATCH/
  // AUTH_CONTEXT_UNKNOWN/SNAPSHOT_INVALIDATED/SNAPSHOT_INCOMPLETE/
  // INPUT_MISMATCH/UNSUPPORTED_FORMAT/UNSUPPORTED_ENCODING/
  // PAYLOAD_UNAVAILABLE/ENGINE_ERROR/PERSISTENCE_ERROR. Enforced via raw
  // CHECK ck_comparison_attempts_reason_code. NO_BASELINE/NO_NEW_SNAPSHOT
  // are Execution availability values, never valid here.
  reasonCode       String? @map("reason_code") @db.VarChar(40)
  reasonDetailSafe String? @map("reason_detail_safe") @db.Text

  // input_check_outcome domain: COMPATIBLE | MISMATCH; NULL before the input
  // gate or when not evaluable. Enforced via raw CHECK
  // ck_comparison_attempts_input_check_outcome.
  inputCheckOutcome String? @map("input_check_outcome") @db.VarChar(20)

  // comparison_result domain: SAME | DIFFERENT; NULL unless COMPLETED
  // (cross-field CHECK ck_comparison_attempts_completed_result).
  comparisonResult String? @map("comparison_result") @db.VarChar(20)

  appliedRuleManifest Json? @map("applied_rule_manifest") @db.JsonB

  startedAt DateTime? @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  findings ComparisonFinding[]

  @@unique([comparisonId, attemptNumber], map: "uq_comparison_attempts_comparison_id_attempt_number")
  @@map("comparison_attempts")
}

// comparison_findings - Group 6/7 Section 4.5. 0..N per attempt: INPUT phase
// findings are a safe mismatch diagnosis, OUTPUT phase findings are Detail
// (unique(attempt_id, phase, finding_ordinal) for stable pagination). Never
// stores raw value_a/value_b - that would duplicate Authorization/cookie/
// file/PII bytes already held immutably by Snapshot; only path/offset/kind/
// a short redacted summary are kept, and Detail is re-derived from Snapshot
// by a backend that re-checks permission (CMP-015/017/018). a_value_kind/
// b_value_kind and rule_code are intentionally left without a CHECK
// constraint: AnD lists their domains as open-ended/non-exhaustive (Section
// 4.5 "...", tied to whatever applied_rule_manifest defines), the same
// "taxonomy not yet frozen" precedent already used for audit_logs.event_type.
model ComparisonFinding {
  comparisonFindingId String @id @default(uuid()) @map("comparison_finding_id") @db.Uuid

  comparisonAttemptId String            @map("comparison_attempt_id") @db.Uuid
  comparisonAttempt   ComparisonAttempt @relation(fields: [comparisonAttemptId], references: [comparisonAttemptId], onDelete: Restrict)

  // phase domain: INPUT | OUTPUT. Enforced via raw CHECK
  // ck_comparison_findings_phase.
  phase String @db.VarChar(20)

  // component domain, used per phase: METHOD/URL/REQUEST_HEADER/
  // REQUEST_BODY (INPUT) or HTTP_STATUS/RESPONSE_HEADER/RESPONSE_BODY
  // (OUTPUT). Enforced via raw CHECK ck_comparison_findings_component.
  component String @db.VarChar(32)

  findingOrdinal Int @map("finding_ordinal")

  // difference_kind domain: PRESENCE | TYPE | VALUE | ORDER | LENGTH |
  // RAW_BYTES. Enforced via raw CHECK ck_comparison_findings_difference_kind.
  differenceKind String @map("difference_kind") @db.VarChar(32)

  // JSON path or header name when determinable; never a fabricated path for
  // raw/binary content (CMP-015/017).
  locationPath String? @map("location_path") @db.Text

  // Raw byte span in each Snapshot, >= 0 when present
  // (ck_comparison_findings_a_byte_offset / _b_byte_offset /
  // _a_byte_length / _b_byte_length).
  aByteOffset BigInt? @map("a_byte_offset")
  bByteOffset BigInt? @map("b_byte_offset")
  aByteLength BigInt? @map("a_byte_length")
  bByteLength BigInt? @map("b_byte_length")

  // Open-ended value-kind domain (ABSENT, NULL, EMPTY_STRING, EMPTY_ARRAY,
  // NUMBER, STRING, ... - AnD Section 4.5) - no CHECK, see model doc comment.
  aValueKind String? @map("a_value_kind") @db.VarChar(20)
  bValueKind String? @map("b_value_kind") @db.VarChar(20)

  // Rule/manifest entry that produced this finding, not a business root
  // cause. Open-ended domain tied to applied_rule_manifest - no CHECK, see
  // model doc comment.
  ruleCode String @map("rule_code") @db.VarChar(60)

  // Redacted description; Detail's authoritative source is Snapshot via a
  // permission-checked backend, never raw secret content here.
  safeSummary String? @map("safe_summary") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([comparisonAttemptId, phase, findingOrdinal], map: "uq_comparison_findings_attempt_id_phase_finding_ordinal")
  @@map("comparison_findings")
}

// comparison_classification_events - Group 6/7 Section 4.6. Append-only
// Expected/Unexpected history (CMP-002); only accepted by the application
// when the Comparison already has a COMPLETED/DIFFERENT attempt - not
// enforced by FK here, guarded by a backend transaction that locks the
// Comparison and re-reads the latest completed attempt. The event with the
// highest revision per Comparison is the current classification
// (uq_comparison_classification_events_comparison_id_revision doubles as the
// optimistic-concurrency conflict check); absence of any event means "not
// yet classified" - there is no NONE/CLEAR value and no scope-approved CLEAR
// operation.
model ComparisonClassificationEvent {
  comparisonClassificationEventId String @id @default(uuid()) @map("comparison_classification_event_id") @db.Uuid

  comparisonId String     @map("comparison_id") @db.Uuid
  comparison   Comparison @relation(fields: [comparisonId], references: [comparisonId], onDelete: Restrict)

  // 1-based, increasing per Comparison (ck_comparison_classification_events_revision).
  revision Int @map("revision")

  // classification domain: EXPECTED | UNEXPECTED. Enforced via raw CHECK
  // ck_comparison_classification_events_classification.
  classification String @db.VarChar(20)

  note String? @db.Text

  classifiedByUserId String @map("classified_by") @db.Uuid
  classifiedBy       User   @relation(fields: [classifiedByUserId], references: [userId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([comparisonId, revision], map: "uq_comparison_classification_events_comparison_id_revision")
  @@map("comparison_classification_events")
}
