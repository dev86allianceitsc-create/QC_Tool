// Database Phase B — User & Authentication implementation.
// Source of truth: document/database/Database_AnD.docx (post VARCHAR Physical
// Design Decision, approved 2026-09-11) and document/database/Database_Standard_v2.0.docx.
//
// Database Phase C — Project Management & Audit Log implementation.
// Source of truth: document/database/AnD_Database_Project_Audit.docx
// (status: IMPLEMENTATION READY - reviewed and frozen for current scope) and
// document/database/Database_Standard_v2.0.docx.
//
// Group 3A — API & Environment Core implementation.
// Source of truth: document/database/AnD_Database_API_Environment_Core_3A.docx
// (status: FINAL FOR 3A LOGICAL DESIGN) and document/database/Database_Standard_v2.0.docx.
// Credential/secret persistence, request params/payload, API/DB version, and
// Run/Snapshot/Comparison are explicitly deferred to Group 3B/3C — out of
// scope here. No new roles/permissions tables — reuses users.system_role and
// project_memberships (REQ-SEC-003 boundary).
//
// Group 3B — Request Input implementation.
// Source of truth: document/database/AnD_Database_Request_Input_3B.docx
// (status: FINAL/FROZEN DB baseline) and document/database/Database_Standard_v2.0.docx.
// Adds Request Input Definition persistence (QUERY/HEADER parameters, JSON
// Request Body definition) for an existing api_configurations row. Path
// Parameters are explicitly NOT persisted — api_configurations.path remains
// their sole source of truth (Section 5). Run Value, payload, credential and
// Authentication data remain out of scope in 3B.
//
// Group 3C — Authentication & Version implementation.
// Source of truth: document/requirement/03_API_Configuration/3C_Authentication_Version
// (REQ-SEC-002 CONFIRMED, REQ-AUTH-001/002/003 REVISED DRAFT) and the
// approved implementation plan (2026-09-21). Credential scope = api_id +
// environment_id + Authentication Configuration (REQ-SEC-002 Section 5); no
// row = auth_type NONE implicitly, same "no row = default state" convention
// as api_environment_configs. No Shared/Reusable Credential Library, no Copy
// Credential (MVP boundary). Secret values (password / bearer token) are
// encrypted at rest (AES-256-GCM, app-level key) and never returned in
// plaintext by any endpoint, to any actor. API/DB Version (REQ-VER-001) has
// no backend persistence in this scope — Run persistence is deferred, so
// Version stays a transient UI-only field (Run Preparation), not modeled here.
//
// Group Run — Run Execution implementation.
// Source of truth: document/requirement/04_Run (REQ-RUN-001..009, FINAL) and
// document/database/AnD_Database_Group_Run Section 17 corrected schema
// (DB-C01..C10 — treated as authoritative over the earlier uncorrected
// section) and Database_Standard_v2.0.docx. Adds `runs` (one row per
// accepted Single/Batch Execute) and `run_executions` (one row per API
// actually dispatched — Status, Outcome, API/DB Version frozen at
// acceptance, redacted Request/Response trace). Batch max-API-count is
// enforced at application layer, not a DB CHECK (DB-C01). Secret credential
// values are never written to run_executions — only the redacted/masked
// request trace is persisted (REQ-RUN-008 RS-008-15), reusing the existing
// AES-256-GCM credential decryption at dispatch time only, in memory.
// skip_reason_code's MISSING_REQUIRED_INPUT value is a Design Proposal: the
// business reason-code contract for the "Batch required-input skip"
// UX-agreed flow is not finalized (DC-01, UI_Requirement_Mapping_Group_Run
// Section 6) and may be renamed/extended by a future controlled migration.
// Snapshot/Comparison (SAME/DIFFERENT, Baseline/Target, field diff) remain
// explicitly out of scope — Run only stores Input and Output.
//
// Scope: users, user_sessions, projects, project_memberships, audit_logs,
// api_configurations, environments, api_environment_configs,
// request_parameter_definitions, request_body_definitions,
// authentication_configurations, runs, run_executions.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  userId          String  @id @default(uuid()) @map("user_id") @db.Uuid
  email           String  @unique @db.VarChar(320)
  googleSubjectId String? @unique @map("google_subject_id") @db.VarChar(255)
  systemRole      String  @map("system_role") @db.VarChar(20)

  // account_status: VARCHAR(30) length is a finalized Physical Design Decision
  // (approved 2026-09-11). Domain (INVITED, ACTIVE, INACTIVE, BLOCKED) and the
  // INVITED->ACTIVE transition are CONFIRMED (Database AnD Section 4.1/5,
  // updated 2026-09-14); enforced via a raw CHECK constraint
  // (ck_users_account_status, migration 20260914180000) not modeled here —
  // Prisma's declarative schema doesn't represent raw CHECK constraints, same
  // as the other 3 CHECK constraints from the initial migration. Other
  // ACTIVE/INACTIVE/BLOCKED transitions remain TBD.
  accountStatus String @map("account_status") @db.VarChar(30)

  activatedAt DateTime? @map("activated_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  note        String?   @db.Text

  sessions    UserSession[]
  memberships ProjectMembership[]
  auditLogs   AuditLog[]
  runs        Run[]

  @@map("users")
}

model UserSession {
  sessionId String @id @default(uuid()) @map("session_id") @db.Uuid

  userId String @map("user_id") @db.Uuid
  // onDelete: Restrict is a DESIGN PROPOSAL / interim physical decision
  // (approved 2026-09-11), not Requirement-confirmed.
  user   User   @relation(fields: [userId], references: [userId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // No DB default — session lifetime is application/config policy, not a
  // fixed DB-side value (Database Design Decision Proposal, 2026-09-11).
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revocationReason String?   @map("revocation_reason") @db.VarChar(255)
  note             String?   @db.Text

  // No `status` column. Session state is derived, not stored:
  //   revoked_at IS NOT NULL                     -> REVOKED
  //   revoked_at IS NULL AND now() >= expires_at  -> EXPIRED
  //   revoked_at IS NULL AND now() <  expires_at  -> ACTIVE

  @@map("user_sessions")
}

model Project {
  projectId String @id @default(uuid()) @map("project_id") @db.Uuid

  // Confirmed NOT UNIQUE — Database AnD (Project/Audit) Section 4 / REQ-PRJ-001:
  // project names may duplicate.
  projectName String @map("project_name") @db.VarChar(255)

  description String? @db.Text

  // NOT NULL, no SQL DEFAULT: "Initial: ACTIVE" is an Initial Business Value
  // (Database AnD Section 4 Notes: "not assumed SQL default"; Database
  // Standard v2.0 Section 14), set explicitly by application code on create —
  // same pattern already used for users.account_status.
  projectStatus String @map("project_status") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  // Soft delete. NULL = not deleted. No deleted_by column (Confirmed —
  // Database AnD Section 13: delete actor is traced through audit_logs).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  note      String?   @db.Text

  memberships  ProjectMembership[]
  auditLogs    AuditLog[]
  apis         ApiConfiguration[]
  environments Environment[]
  runs         Run[]

  @@index([projectStatus, deletedAt], map: "idx_projects_status_deleted")
  @@map("projects")
}

model ProjectMembership {
  userId    String @map("user_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  // Both onDelete: Restrict are DESIGN PROPOSAL / interim physical decisions
  // (approved 2026-09-11), not Requirement-confirmed.
  user    User    @relation(fields: [userId], references: [userId], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  note      String?  @db.Text

  @@id([userId, projectId], map: "pk_project_memberships")
  @@index([projectId], map: "idx_project_memberships_project_id")
  @@map("project_memberships")
}

// audit_logs — Database AnD (Project/Audit) Section 7/8/9. Append-only at
// application policy (no normal application Update/Delete); never stores
// password, secret or full token (Database Standard v2.0 Section 22).
model AuditLog {
  auditId String @id(map: "pk_audit_logs") @default(uuid()) @map("audit_id") @db.Uuid

  // No DB CHECK for event_type in this migration — taxonomy not yet frozen
  // (Database AnD Section 7/13, explicit instruction).
  eventType String @map("event_type") @db.VarChar(50)
  // CHECK ck_audit_logs_result: SUCCESS/FAILURE/DENIED.
  result    String @db.VarChar(20)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  // Nullable, ON DELETE SET NULL — audit history survives actor deletion.
  // actorDisplay is an intentional historical/searchable snapshot, kept even
  // if actorUserId is later nulled out.
  actorUserId  String? @map("actor_user_id") @db.Uuid
  actor        User?   @relation(fields: [actorUserId], references: [userId], onDelete: SetNull, map: "fk_audit_logs_actor_user_id")
  actorDisplay String? @map("actor_display") @db.VarChar(320)

  // Generic target: target_type + target_id, no polymorphic FK (Confirmed —
  // Database AnD Section 3/7).
  targetType    String? @map("target_type") @db.VarChar(50)
  targetId      String? @map("target_id") @db.VarChar(255)
  targetDisplay String? @map("target_display") @db.VarChar(320)

  // Nullable, ON DELETE SET NULL — audit history survives project deletion.
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [projectId], onDelete: SetNull, map: "fk_audit_logs_project_id")

  // PostgreSQL JSONB per Database AnD Section 7/9; sanitized before
  // persistence, never contains secrets/tokens/passwords.
  beforeData Json? @map("before_data") @db.JsonB
  afterData  Json? @map("after_data") @db.JsonB

  requestId String? @map("request_id") @db.VarChar(100)
  detail    String? @db.Text
  note      String? @db.Text

  // No index on `result` (explicit instruction). No automatic purge/retention
  // in this scope (Database AnD Section 9/13 — TBD, non-blocking).
  @@index([occurredAt(sort: Desc)], map: "idx_audit_logs_occurred_at")
  @@index([projectId, occurredAt(sort: Desc)], map: "idx_audit_logs_project_time")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "idx_audit_logs_actor_time")
  @@index([eventType, occurredAt(sort: Desc)], map: "idx_audit_logs_event_time")
  @@map("audit_logs")
}

// api_configurations — Database AnD (API & Environment Core 3A) Section 6.
// Active business identity = project_id + http_method + path (api_name is
// explicitly NOT part of it — REQ-FUN-002 FR-FUN-002-14/15). Soft delete via
// deleted_at preserves Run/Snapshot/Comparison history (REQ-FUN-001
// FR-FUN-001-09/10); a soft-deleted row must not block reuse of the same
// Method+Path. The active-uniqueness partial index (ux_api_configurations_active,
// scoped to deleted_at IS NULL) cannot be expressed declaratively in Prisma —
// added via raw SQL in the migration, same convention as the CHECK
// constraints below.
model ApiConfiguration {
  apiId String @id @default(uuid()) @map("api_id") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  apiName     String  @map("api_name") @db.VarChar(255)
  httpMethod  String  @map("http_method") @db.VarChar(10)
  path        String  @db.VarChar(2048)
  description String? @db.Text

  // creation_source domain: MANUAL | OPENAPI_IMPORT (REQ-FUN-002). Enforced
  // via raw CHECK ck_api_configurations_creation_source, not modeled here.
  creationSource String @map("creation_source") @db.VarChar(30)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  // Soft delete. NULL = active. No deleted_by column (same convention as
  // projects — delete actor traced through audit_logs).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  note      String?   @db.Text

  configs ApiEnvironmentConfig[]

  parameterDefinitions RequestParameterDefinition[]
  bodyDefinition       RequestBodyDefinition?
  authConfigs          AuthenticationConfiguration[]
  runExecutions        RunExecution[]

  @@index([projectId, deletedAt], map: "idx_api_configurations_project_deleted")
  @@map("api_configurations")
}

// environments — Database AnD (API & Environment Core 3A) Section 7/8.
// Identity within a Project = project_id + environment_name (unique,
// case-insensitive after trim — REQ-ENV-001 FR-ENV-001-05/06 — including
// INACTIVE rows). No hard delete; ACTIVE/INACTIVE lifecycle only
// (environment_status), independent of allow_run (REQ-ENV-003). The
// case-insensitive unique index (ux_environments_project_name_ci) cannot be
// expressed declaratively in Prisma — added via raw SQL in the migration.
// classification (PRODUCTION/NON_PRODUCTION) is independent of
// environment_name (REQ-ENV-001 FR-ENV-001-12); default Allow Run
// ON/OFF-by-classification and the atomic non-Prod->Prod OFF-forcing
// transition (REQ-ENV-003) are application business logic, not DB defaults.
model Environment {
  environmentId String @id @default(uuid()) @map("environment_id") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  environmentName String @map("environment_name") @db.VarChar(100)

  // classification domain: PRODUCTION | NON_PRODUCTION. Enforced via raw
  // CHECK ck_environments_classification, not modeled here.
  classification String @db.VarChar(20)

  allowRun Boolean @map("allow_run")

  // environment_status domain: ACTIVE | INACTIVE. Enforced via raw CHECK
  // ck_environments_environment_status, not modeled here.
  environmentStatus String @map("environment_status") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  note      String?  @db.Text

  configs     ApiEnvironmentConfig[]
  authConfigs AuthenticationConfiguration[]
  runs        Run[]

  @@index([projectId], map: "idx_environments_project_id")
  @@map("environments")
}

// api_environment_configs — Database AnD (API & Environment Core 3A) Section 9,
// DEC-3A-DB-001 (CONFIRMED): no row = Not configured; a row exists only after
// Full URL is successfully saved, so full_url is NOT NULL. Relationship
// identity = (api_id, environment_id). FK delete behavior kept RESTRICT
// (not CASCADE) per the frozen AnD's history-preserving instruction
// (TBD-3A-DB-002 — exact downstream Run/Snapshot behavior deferred, but
// CASCADE is explicitly disallowed in the interim).
model ApiEnvironmentConfig {
  apiId         String           @map("api_id") @db.Uuid
  api           ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)
  environmentId String           @map("environment_id") @db.Uuid
  environment   Environment      @relation(fields: [environmentId], references: [environmentId], onDelete: Restrict)

  fullUrl String @map("full_url") @db.VarChar(4096)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  note      String?  @db.Text

  @@id([apiId, environmentId], map: "pk_api_environment_configs")
  @@index([environmentId], map: "idx_api_environment_configs_environment_id")
  @@map("api_environment_configs")
}

// request_parameter_definitions — Database AnD (Request Input 3B) Section 6/7/12.
// Definition-only: QUERY/HEADER parameter name + Required/Optional state that
// the User configures for an API. No Run Value, credential, default value or
// advanced schema metadata (REQ-INP-003 RS-06/BR-INP-003-24; REQ-INP-004).
// PATH parameters are intentionally NOT modeled here — api_configurations.path
// remains their sole source of truth (Section 5, DB-STD-02 Single Source of
// Truth). Definition is API-level and shared across Environments (no
// environment_id column — BR-INP-003-21/25).
//
// Uniqueness (DB-3B-PAR-01..04) needs two different case sensitivities for
// the same (api_id, parameter_name) shape depending on location, which
// Prisma's declarative `@@unique` cannot express as partial/functional
// indexes — added via raw SQL in the migration:
//   - QUERY: case-sensitive unique on (api_id, parameter_name)
//   - HEADER: case-insensitive unique on (api_id, lower(parameter_name))
// A QUERY and a HEADER definition may share the same spelling because
// location is part of the uniqueness boundary (DB-3B-PAR-04).
model RequestParameterDefinition {
  requestParameterDefinitionId String @id @default(uuid()) @map("request_parameter_definition_id") @db.Uuid

  apiId String           @map("api_id") @db.Uuid
  api   ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)

  // location domain: QUERY | HEADER. Enforced via raw CHECK
  // ck_request_parameter_definitions_location, not modeled here. PATH/BODY
  // are never persisted as parameter rows (Section 12).
  location String @db.VarChar(20)

  parameterName String @map("parameter_name") @db.VarChar(255)

  isRequired Boolean @map("is_required")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  note      String?  @db.Text

  @@index([apiId, location], map: "idx_request_parameter_definitions_api_id_location")
  @@map("request_parameter_definitions")
}

// request_body_definitions — Database AnD (Request Input 3B) Section 8/9/12.
// 0..1 per API (api_id UNIQUE): whether the API has a Request Body and which
// Body Type. MVP supports only body_type = JSON; the field is named
// generically so future body types can be added by a controlled migration
// without renaming (AD-INP-005-01). Never stores the JSON payload itself —
// Run Payload persistence belongs to Run/Snapshot scope (REQ-INP-004/005).
model RequestBodyDefinition {
  requestBodyDefinitionId String @id @default(uuid()) @map("request_body_definition_id") @db.Uuid

  apiId String           @unique @map("api_id") @db.Uuid
  api   ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)

  // body_type domain: JSON only in MVP. Enforced via raw CHECK
  // ck_request_body_definitions_body_type, not modeled here. Generic naming
  // per AD-INP-005-01 to allow controlled future expansion.
  bodyType String @map("body_type") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  note      String?  @db.Text

  @@map("request_body_definitions")
}

// authentication_configurations — Group 3C (REQ-SEC-002 CONFIRMED,
// REQ-AUTH-001/002/003). No row = auth_type NONE implicitly, same "no row =
// Not configured" convention as api_environment_configs. Relationship
// identity = (api_id, environment_id) — credential isolation boundary per
// REQ-SEC-002 Section 5; never shared/copied across API or Environment.
//
// LOGIN_FORM non-secret config (login_url, username, username_field,
// password_field, token_response_path) is Credential Metadata per
// REQ-SEC-002's terminology table and may be read by Admin and User with
// Project Access. The secret columns below are Secret Credential Value and
// are NEVER returned in plaintext by any endpoint, to any actor — only
// Configured/Not configured status is exposed. Exactly one secret pair is
// populated at a time, matching the currently selected auth_type; switching
// auth_type (CL-3C-02, REQ-AUTH-003) clears the previous type's secret in
// the same mutation.
model AuthenticationConfiguration {
  apiId         String           @map("api_id") @db.Uuid
  api           ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)
  environmentId String           @map("environment_id") @db.Uuid
  environment   Environment      @relation(fields: [environmentId], references: [environmentId], onDelete: Restrict)

  // auth_type domain: NONE | LOGIN_FORM | BEARER_TOKEN. Enforced via raw
  // CHECK ck_authentication_configurations_auth_type, not modeled here.
  authType String @map("auth_type") @db.VarChar(20)

  // LOGIN_FORM config — non-secret, null unless auth_type = LOGIN_FORM.
  loginUrl          String? @map("login_url") @db.VarChar(2048)
  username          String? @db.VarChar(255)
  usernameField     String? @map("username_field") @db.VarChar(100)
  passwordField     String? @map("password_field") @db.VarChar(100)
  tokenResponsePath String? @map("token_response_path") @db.VarChar(200)

  // Secret, encrypted at rest (AES-256-GCM, app-level CREDENTIAL_ENCRYPTION_KEY).
  // Populated only when auth_type = LOGIN_FORM and a password has been set.
  passwordCiphertext Bytes? @map("password_ciphertext")
  passwordIv         Bytes? @map("password_iv")
  passwordAuthTag    Bytes? @map("password_auth_tag")

  // Secret, encrypted at rest. Populated only when auth_type = BEARER_TOKEN
  // and a token has been set.
  bearerTokenCiphertext Bytes? @map("bearer_token_ciphertext")
  bearerTokenIv         Bytes? @map("bearer_token_iv")
  bearerTokenAuthTag    Bytes? @map("bearer_token_auth_tag")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  note      String?  @db.Text

  @@id([apiId, environmentId], map: "pk_authentication_configurations")
  @@index([environmentId], map: "idx_authentication_configurations_environment_id")
  @@map("authentication_configurations")
}

// runs — Group Run, document/database/AnD_Database_Group_Run Section 17
// (DB-C01..C10 corrected). One row per accepted Single or Batch Execute
// (REQ-RUN-001). Single = exactly 1 RunExecution; Batch = up to the
// application-enforced max (DB-C01 — not a DB CHECK). Immutable history:
// no application Update/Delete once created, no soft delete.
model Run {
  runId String @id @default(uuid()) @map("run_id") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  environmentId String      @map("environment_id") @db.Uuid
  environment   Environment @relation(fields: [environmentId], references: [environmentId], onDelete: Restrict)

  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation(fields: [createdBy], references: [userId], onDelete: Restrict)

  // run_type domain: SINGLE | BATCH. Enforced via raw CHECK
  // ck_runs_run_type, not modeled here.
  runType String @map("run_type") @db.VarChar(20)

  // run_status domain: PENDING | RUNNING | COMPLETED | INTERRUPTED
  // (Run/Batch-level rollup — SKIPPED/NOT_EXECUTED exist only at the
  // RunExecution level, REQ-RUN-007). Enforced via raw CHECK
  // ck_runs_run_status. NOT NULL, no SQL default — set explicitly by
  // application code at acceptance (PENDING), same convention as
  // projects.project_status / users.account_status.
  runStatus String @map("run_status") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  startedAt DateTime? @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz
  note      String?   @db.Text

  executions RunExecution[]

  @@index([projectId, createdAt(sort: Desc)], map: "idx_runs_project_id_created_at")
  @@map("runs")
}

// run_executions — Group Run, document/database/AnD_Database_Group_Run
// Section 17 (DB-C01..C10 corrected). One row per API actually dispatched
// within a Run (Single or Batch child). Status and Outcome are
// intentionally separate columns (REQ-RUN-007/008 BR-02): Status tracks
// lifecycle (PENDING/RUNNING/COMPLETED/SKIPPED/INTERRUPTED/NOT_EXECUTED),
// Outcome tracks result classification (RESPONSE_RECEIVED/RUN_ERROR/
// SKIPPED). Request/Response trace columns are populated only once actually
// dispatched, already redacted/masked (REQ-RUN-008 RS-008-15) — never the
// real secret credential value. Immutable history once written.
model RunExecution {
  runExecutionId String @id @default(uuid()) @map("run_execution_id") @db.Uuid

  runId String @map("run_id") @db.Uuid
  run   Run    @relation(fields: [runId], references: [runId], onDelete: Restrict)

  apiId String           @map("api_id") @db.Uuid
  api   ApiConfiguration @relation(fields: [apiId], references: [apiId], onDelete: Restrict)

  // 1-based position within the Run's selection order (Single is always 1).
  // Enforced >= 1 via raw CHECK ck_run_executions_execution_order.
  executionOrder Int @map("execution_order")

  // execution_status domain: PENDING | RUNNING | COMPLETED | SKIPPED |
  // INTERRUPTED | NOT_EXECUTED. Enforced via raw CHECK
  // ck_run_executions_execution_status, not modeled here.
  executionStatus String @map("execution_status") @db.VarChar(20)

  // execution_outcome domain: RESPONSE_RECEIVED | RUN_ERROR | SKIPPED.
  // Nullable — no outcome yet while PENDING/RUNNING, and INTERRUPTED/
  // NOT_EXECUTED never receive one (REQ-RUN-007/008 BR-02). Enforced via raw
  // CHECK ck_run_executions_execution_outcome.
  executionOutcome String? @map("execution_outcome") @db.VarChar(20)

  // skip_reason_code: CONFIRMED value is MISSING_FULL_URL (REQ-RUN-001
  // RS-001-08 — Batch-only; missing Full URL never blocks Batch acceptance,
  // the API is SKIPPED instead, no request sent). MISSING_REQUIRED_INPUT is
  // a Design Proposal for the UX-agreed "review & confirm skip" flow (DC-01,
  // UI_Requirement_Mapping_Group_Run Section 6) — not finalized, may be
  // renamed/extended by a future controlled migration. Enforced via raw
  // CHECK ck_run_executions_skip_reason_code.
  skipReasonCode String? @map("skip_reason_code") @db.VarChar(50)

  // error_reason_code: set only when execution_outcome = RUN_ERROR.
  // HTTP_ERROR covers HTTP 4xx/5xx (REQ-RUN-002, http_status populated); the
  // other 5 values cover transport failures with no HTTP response
  // (REQ-RUN-003, http_status null). Enforced via raw CHECK
  // ck_run_executions_error_reason_code.
  errorReasonCode  String? @map("error_reason_code") @db.VarChar(50)
  errorMessageSafe String? @map("error_message_safe") @db.Text

  // API/Database Version (REQ-RUN-009). NOT NULL, no SQL default — app
  // resolves manual > configured-if-supported > UNKNOWN and freezes the
  // value at Execute acceptance; never rewritten for an existing Run.
  apiVersion      String @map("api_version") @db.VarChar(100)
  databaseVersion String @map("database_version") @db.VarChar(100)

  // Actual Request trace (REQ-RUN-008 RS-008-05), already redacted/masked
  // before persistence (RS-008-15). Null until the request is actually
  // dispatched — never populated for SKIPPED/NOT_EXECUTED (RS-008-09).
  requestMethod      String?   @map("request_method") @db.VarChar(10)
  requestUrlSafe     String?   @map("request_url_safe") @db.VarChar(4096)
  requestQuerySafe   Json?     @map("request_query_safe") @db.JsonB
  requestHeadersSafe Json?     @map("request_headers_safe") @db.JsonB
  requestBodySafe    String?   @map("request_body_safe") @db.Text
  requestContentType String?   @map("request_content_type") @db.VarChar(255)
  requestSentAt      DateTime? @map("request_sent_at") @db.Timestamptz

  // Actual HTTP Response trace (REQ-RUN-008 RS-008-06). http_status is null
  // when no response was ever received (transport failure, REQ-RUN-003).
  httpStatus          Int?    @map("http_status")
  responseHeadersSafe Json?   @map("response_headers_safe") @db.JsonB
  responseBodySafe    String? @map("response_body_safe") @db.Text
  responseContentType String? @map("response_content_type") @db.VarChar(255)

  // response_body_kind domain: TEXT | BINARY (REQ-RUN-008 BR-11: JSON and
  // other text are both stored as TEXT; binary/file responses persist
  // metadata only, never the body — RS-008-18). Enforced via raw CHECK
  // ck_run_executions_response_body_kind.
  responseBodyKind String? @map("response_body_kind") @db.VarChar(20)

  // NOT NULL — the app always states explicitly whether the stored body was
  // cut, never left to a DB default (same "no silent default" convention as
  // environments.allow_run).
  responseBodyIsTruncated Boolean   @map("response_body_is_truncated")
  responseBodySizeBytes   Int?      @map("response_body_size_bytes")
  responseBodyStoredBytes Int?      @map("response_body_stored_bytes")
  responseReceivedAt      DateTime? @map("response_received_at") @db.Timestamptz

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  startedAt  DateTime? @map("started_at") @db.Timestamptz
  endedAt    DateTime? @map("ended_at") @db.Timestamptz
  durationMs Int?      @map("duration_ms")
  note       String?   @db.Text

  @@unique([runId, apiId], map: "uq_run_executions_run_id_api_id")
  @@unique([runId, executionOrder], map: "uq_run_executions_run_id_execution_order")
  @@index([apiId, createdAt(sort: Desc)], map: "idx_run_executions_api_id_created_at")
  @@map("run_executions")
}
