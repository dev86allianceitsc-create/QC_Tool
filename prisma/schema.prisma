// Database Phase B — User & Authentication implementation.
// Source of truth: document/database/Database_AnD.docx (post VARCHAR Physical
// Design Decision, approved 2026-09-11) and document/database/Database_Standard_v2.0.docx.
//
// Database Phase C — Project Management & Audit Log implementation.
// Source of truth: document/database/AnD_Database_Project_Audit.docx
// (status: IMPLEMENTATION READY - reviewed and frozen for current scope) and
// document/database/Database_Standard_v2.0.docx.
//
// Scope: users, user_sessions, projects, project_memberships, audit_logs.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  userId          String  @id @default(uuid()) @map("user_id") @db.Uuid
  email           String  @unique @db.VarChar(320)
  googleSubjectId String? @unique @map("google_subject_id") @db.VarChar(255)
  systemRole      String  @map("system_role") @db.VarChar(20)

  // account_status: VARCHAR(30) length is a finalized Physical Design Decision
  // (approved 2026-09-11). Domain (INVITED, ACTIVE, INACTIVE, BLOCKED) and the
  // INVITED->ACTIVE transition are CONFIRMED (Database AnD Section 4.1/5,
  // updated 2026-09-14); enforced via a raw CHECK constraint
  // (ck_users_account_status, migration 20260914180000) not modeled here —
  // Prisma's declarative schema doesn't represent raw CHECK constraints, same
  // as the other 3 CHECK constraints from the initial migration. Other
  // ACTIVE/INACTIVE/BLOCKED transitions remain TBD.
  accountStatus String @map("account_status") @db.VarChar(30)

  activatedAt DateTime? @map("activated_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  note        String?   @db.Text

  sessions    UserSession[]
  memberships ProjectMembership[]
  auditLogs   AuditLog[]

  @@map("users")
}

model UserSession {
  sessionId String @id @default(uuid()) @map("session_id") @db.Uuid

  userId String @map("user_id") @db.Uuid
  // onDelete: Restrict is a DESIGN PROPOSAL / interim physical decision
  // (approved 2026-09-11), not Requirement-confirmed.
  user   User   @relation(fields: [userId], references: [userId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // No DB default — session lifetime is application/config policy, not a
  // fixed DB-side value (Database Design Decision Proposal, 2026-09-11).
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revocationReason String?   @map("revocation_reason") @db.VarChar(255)
  note             String?   @db.Text

  // No `status` column. Session state is derived, not stored:
  //   revoked_at IS NOT NULL                     -> REVOKED
  //   revoked_at IS NULL AND now() >= expires_at  -> EXPIRED
  //   revoked_at IS NULL AND now() <  expires_at  -> ACTIVE

  @@map("user_sessions")
}

model Project {
  projectId String @id @default(uuid()) @map("project_id") @db.Uuid

  // Confirmed NOT UNIQUE — Database AnD (Project/Audit) Section 4 / REQ-PRJ-001:
  // project names may duplicate.
  projectName String @map("project_name") @db.VarChar(255)

  description String? @db.Text

  // NOT NULL, no SQL DEFAULT: "Initial: ACTIVE" is an Initial Business Value
  // (Database AnD Section 4 Notes: "not assumed SQL default"; Database
  // Standard v2.0 Section 14), set explicitly by application code on create —
  // same pattern already used for users.account_status.
  projectStatus String @map("project_status") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  // Soft delete. NULL = not deleted. No deleted_by column (Confirmed —
  // Database AnD Section 13: delete actor is traced through audit_logs).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  note      String?   @db.Text

  memberships ProjectMembership[]
  auditLogs   AuditLog[]

  @@index([projectStatus, deletedAt], map: "idx_projects_status_deleted")
  @@map("projects")
}

model ProjectMembership {
  userId    String @map("user_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  // Both onDelete: Restrict are DESIGN PROPOSAL / interim physical decisions
  // (approved 2026-09-11), not Requirement-confirmed.
  user    User    @relation(fields: [userId], references: [userId], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  note      String?  @db.Text

  @@id([userId, projectId], map: "pk_project_memberships")
  @@index([projectId], map: "idx_project_memberships_project_id")
  @@map("project_memberships")
}

// audit_logs — Database AnD (Project/Audit) Section 7/8/9. Append-only at
// application policy (no normal application Update/Delete); never stores
// password, secret or full token (Database Standard v2.0 Section 22).
model AuditLog {
  auditId String @id(map: "pk_audit_logs") @default(uuid()) @map("audit_id") @db.Uuid

  // No DB CHECK for event_type in this migration — taxonomy not yet frozen
  // (Database AnD Section 7/13, explicit instruction).
  eventType String @map("event_type") @db.VarChar(50)
  // CHECK ck_audit_logs_result: SUCCESS/FAILURE/DENIED.
  result    String @db.VarChar(20)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  // Nullable, ON DELETE SET NULL — audit history survives actor deletion.
  // actorDisplay is an intentional historical/searchable snapshot, kept even
  // if actorUserId is later nulled out.
  actorUserId  String? @map("actor_user_id") @db.Uuid
  actor        User?   @relation(fields: [actorUserId], references: [userId], onDelete: SetNull, map: "fk_audit_logs_actor_user_id")
  actorDisplay String? @map("actor_display") @db.VarChar(320)

  // Generic target: target_type + target_id, no polymorphic FK (Confirmed —
  // Database AnD Section 3/7).
  targetType    String? @map("target_type") @db.VarChar(50)
  targetId      String? @map("target_id") @db.VarChar(255)
  targetDisplay String? @map("target_display") @db.VarChar(320)

  // Nullable, ON DELETE SET NULL — audit history survives project deletion.
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [projectId], onDelete: SetNull, map: "fk_audit_logs_project_id")

  // PostgreSQL JSONB per Database AnD Section 7/9; sanitized before
  // persistence, never contains secrets/tokens/passwords.
  beforeData Json? @map("before_data") @db.JsonB
  afterData  Json? @map("after_data") @db.JsonB

  requestId String? @map("request_id") @db.VarChar(100)
  detail    String? @db.Text
  note      String? @db.Text

  // No index on `result` (explicit instruction). No automatic purge/retention
  // in this scope (Database AnD Section 9/13 — TBD, non-blocking).
  @@index([occurredAt(sort: Desc)], map: "idx_audit_logs_occurred_at")
  @@index([projectId, occurredAt(sort: Desc)], map: "idx_audit_logs_project_time")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "idx_audit_logs_actor_time")
  @@index([eventType, occurredAt(sort: Desc)], map: "idx_audit_logs_event_time")
  @@map("audit_logs")
}
